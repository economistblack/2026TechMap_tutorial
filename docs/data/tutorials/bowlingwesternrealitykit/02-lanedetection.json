owlingwesternrealitykit\/03-westernoverlay#%EC%A0%A0%ED%8B%80%EB%A7%A8%EB%A6%AC%EA%B7%B8-%ED%86%A4-%EC%A0%81%EC%9A%A9","kind":"section","abstract":[{"type":"text","text":"RealityKit 엔티티와 배경 합성을 사용해 볼러는 원본 영상으로 유지하고, 볼러 뒤의 볼링장 배경만 살룬과 석양이 있는 서부극 장면으로 바꿉니다."}],"type":"section","identifier":"doc:\/\/com.gentlemanleague.BowlingWesternRealityKit\/tutorials\/BowlingWesternRealityKit\/03-WesternOverlay#%EC%A0%A0%ED%8B%80%EB%A7%A8%EB%A6%AC%EA%B7%B8-%ED%86%A4-%EC%A0%81%EC%9A%A9","role":"pseudoSymbol","title":"젠틀맨리그 톤 적용"},"09-LiveLaneDetector.swift":{"syntax":"swift","content":["import ARKit","import Vision","","struct LiveLaneDetector {","    func detectLane(in frame: ARFrame) async throws -> BowlingLaneAnchorDescription? {","        let request = VNDetectContoursRequest()","        request.contrastAdjustment = 1.2","        request.detectsDarkOnLight = true","","        let handler = VNImageRequestHandler(","            cvPixelBuffer: frame.capturedImage,","            orientation: .right","        )","        try handler.perform([request])","","        \/\/ Convert the strongest lane-like contour into a lane anchor in a real app.","        return nil","    }","}"],"highlights":[],"type":"file","fileType":"swift","fileName":"LiveLaneDetector.swift","identifier":"09-LiveLaneDetector.swift"},"03-LaneAnchorDescription.swift":{"content":["struct BowlingLaneAnchorDescription {","    let centerX: Double","    let centerY: Double","    let width: Double","    let vanishingPointY: Double","}"],"identifier":"03-LaneAnchorDescription.swift","fileType":"swift","fileName":"LaneAnchorDescription.swift","syntax":"swift","type":"file","highlights":[]},"04-LiveARSessionView.swift":{"type":"file","identifier":"04-LiveARSessionView.swift","fileType":"swift","content":["import ARKit","import RealityKit","import SwiftUI","","struct LiveARSessionView: UIViewRepresentable {","    @Binding var captureModel: LiveCaptureModel","","    func makeUIView(context: Context) -> ARView {","        let arView = ARView(frame: .zero)","        let configuration = ARWorldTrackingConfiguration()","        configuration.planeDetection = [.horizontal]","        arView.session.run(configuration)","        captureModel.status = .scanningPlane","        return arView","    }","","    func updateUIView(_ arView: ARView, context: Context) {}","}"],"highlights":[],"syntax":"swift","fileName":"LiveARSessionView.swift"},"doc://com.gentlemanleague.BowlingWesternRealityKit/tutorials/BowlingWesternRealityKit/02-LaneDetection#%EB%B3%BC%EB%9F%AC-%EB%A7%88%EC%8A%A4%ED%81%AC%EC%99%80-AR-%EA%B8%B0%EC%A4%80-%EC%9E%A1%EA%B8%B0":{"type":"section","identifier":"doc:\/\/com.gentlemanleague.BowlingWesternRealityKit\/tutorials\/BowlingWesternRealityKit\/02-LaneDetection#%EB%B3%BC%EB%9F%AC-%EB%A7%88%EC%8A%A4%ED%81%AC%EC%99%80-AR-%EA%B8%B0%EC%A4%80-%EC%9E%A1%EA%B8%B0","role":"pseudoSymbol","abstract":[{"type":"text","text":"촬영 중 Vision으로 볼러 영역을 분리하고, ARKit과 레인 기준 인식으로 볼러 뒤 배경을 서부극 장면에 맞게 정렬합니다."}],"url":"\/tutorials\/bowlingwesternrealitykit\/02-lanedetection#%EB%B3%BC%EB%9F%AC-%EB%A7%88%EC%8A%A4%ED%81%AC%EC%99%80-AR-%EA%B8%B0%EC%A4%80-%EC%9E%A1%EA%B8%B0","title":"볼러 마스크와 AR 기준 잡기","kind":"section"},"doc://com.gentlemanleague.BowlingWesternRealityKit/tutorials/BowlingWesternRealityKit/01-ProjectSetup#%EA%B6%8C%ED%95%9C%EA%B3%BC-%EC%9E%85%EB%A0%A5-%EC%A4%80%EB%B9%84":{"type":"section","abstract":[{"type":"text","text":"SwiftUI 앱에서 ARKit 카메라 세션, Vision 사람 분리, RealityKit 배경 장면을 연결해 촬영 중 배경 변환을 표시할 준비를 합니다."}],"url":"\/tutorials\/bowlingwesternrealitykit\/01-projectsetup#%EA%B6%8C%ED%95%9C%EA%B3%BC-%EC%9E%85%EB%A0%A5-%EC%A4%80%EB%B9%84","title":"권한과 입력 준비","role":"pseudoSymbol","kind":"section","identifier":"doc:\/\/com.gentlemanleague.BowlingWesternRealityKit\/tutorials\/BowlingWesternRealityKit\/01-ProjectSetup#%EA%B6%8C%ED%95%9C%EA%B3%BC-%EC%9E%85%EB%A0%A5-%EC%A4%80%EB%B9%84"},"09-BowlerSegmentationModel.swift":{"type":"file","fileName":"BowlerSegmentationModel.swift","fileType":"swift","content":["import CoreImage","import Vision","","struct BowlerSegmentationModel {","    func makePersonMask(from pixelBuffer: CVPixelBuffer) async throws -> CIImage? {","        let request = VNGeneratePersonSegmentationRequest()","        request.qualityLevel = .balanced","        request.outputPixelFormat = kCVPixelFormatType_OneComponent8","","        let handler = VNImageRequestHandler(cvPixelBuffer: pixelBuffer)","        try handler.perform([request])","","        guard let mask = request.results?.first?.pixelBuffer else {","            return nil","        }","","        return CIImage(cvPixelBuffer: mask)","    }","}"],"syntax":"swift","identifier":"09-BowlerSegmentationModel.swift","highlights":[]},"doc://com.gentlemanleague.BowlingWesternRealityKit/tutorials/BowlingWesternRealityKit/03-WesternOverlay#RealityKit-%EB%B0%B0%EA%B2%BD-%EC%9E%A5%EB%A9%B4-%EA%B5%AC%EC%84%B1":{"title":"RealityKit 배경 장면 구성","identifier":"doc:\/\/com.gentlemanleague.BowlingWesternRealityKit\/tutorials\/BowlingWesternRealityKit\/03-WesternOverlay#RealityKit-%EB%B0%B0%EA%B2%BD-%EC%9E%A5%EB%A9%B4-%EA%B5%AC%EC%84%B1","role":"pseudoSymbol","url":"\/tutorials\/bowlingwesternrealitykit\/03-westernoverlay#RealityKit-%EB%B0%B0%EA%B2%BD-%EC%9E%A5%EB%A9%B4-%EA%B5%AC%EC%84%B1","abstract":[{"type":"text","text":"RealityKit 엔티티와 배경 합성을 사용해 볼러는 원본 영상으로 유지하고, 볼러 뒤의 볼링장 배경만 살룬과 석양이 있는 서부극 장면으로 바꿉니다."}],"kind":"section","type":"section"},"doc://com.gentlemanleague.BowlingWesternRealityKit/tutorials/BowlingWesternRealityKit/--------":{"title":"앱 기반 만들기","identifier":"doc:\/\/com.gentlemanleague.BowlingWesternRealityKit\/tutorials\/BowlingWesternRealityKit\/--------","role":"article","url":"\/tutorials\/bowlingwesternrealitykit\/--------","abstract":[],"type":"topic","kind":"article"},"doc://com.gentlemanleague.BowlingWesternRealityKit/tutorials/BowlingWesternRealityKit/04-VideoExport#GitHub-Pages-%EB%B0%B0%ED%8F%AC-%EC%A4%80%EB%B9%84":{"type":"section","identifier":"doc:\/\/com.gentlemanleague.BowlingWesternRea