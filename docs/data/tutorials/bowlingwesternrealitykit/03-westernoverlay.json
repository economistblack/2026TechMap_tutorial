mbol","kind":"section","identifier":"doc:\/\/com.gentlemanleague.BowlingWesternRealityKit\/tutorials\/BowlingWesternRealityKit\/02-LaneDetection#%EB%B0%B0%EA%B2%BD-%EA%B5%90%EC%B2%B4%EB%A5%BC-%EC%9C%84%ED%95%9C-%EB%B3%B4%EC%A0%95"},"10-MaskedWesternCompositor.swift":{"syntax":"swift","content":["import CoreImage","","struct MaskedWesternCompositor {","    private let context = CIContext()","","    func composite(","        cameraFrame: CIImage,","        westernBackground: CIImage,","        bowlerMask: CIImage","    ) -> CIImage {","        let filter = CIFilter.blendWithMask()","        filter.inputImage = cameraFrame","        filter.backgroundImage = westernBackground","        filter.maskImage = bowlerMask","        return filter.outputImage ?? cameraFrame","    }","}"],"highlights":[],"type":"file","fileType":"swift","identifier":"10-MaskedWesternCompositor.swift","fileName":"MaskedWesternCompositor.swift"},"doc://com.gentlemanleague.BowlingWesternRealityKit/tutorials/BowlingWesternRealityKit/03-WesternOverlay#%EC%A0%A0%ED%8B%80%EB%A7%A8%EB%A6%AC%EA%B7%B8-%ED%86%A4-%EC%A0%81%EC%9A%A9":{"url":"\/tutorials\/bowlingwesternrealitykit\/03-westernoverlay#%EC%A0%A0%ED%8B%80%EB%A7%A8%EB%A6%AC%EA%B7%B8-%ED%86%A4-%EC%A0%81%EC%9A%A9","kind":"section","abstract":[{"type":"text","text":"RealityKit 엔티티와 배경 합성을 사용해 볼러는 원본 영상으로 유지하고, 볼러 뒤의 볼링장 배경만 살룬과 석양이 있는 서부극 장면으로 바꿉니다."}],"type":"section","identifier":"doc:\/\/com.gentlemanleague.BowlingWesternRealityKit\/tutorials\/BowlingWesternRealityKit\/03-WesternOverlay#%EC%A0%A0%ED%8B%80%EB%A7%A8%EB%A6%AC%EA%B7%B8-%ED%86%A4-%EC%A0%81%EC%9A%A9","role":"pseudoSymbol","title":"젠틀맨리그 톤 적용"},"doc://com.gentlemanleague.BowlingWesternRealityKit/tutorials/BowlingWesternRealityKit/01-ProjectSetup#SwiftUI%EC%99%80-RealityKit-%EC%97%B0%EA%B2%B0":{"type":"section","abstract":[{"text":"SwiftUI 앱에서 ARKit 카메라 세션, Vision 사람 분리, RealityKit 배경 장면을 연결해 촬영 중 배경 변환을 표시할 준비를 합니다.","type":"text"}],"url":"\/tutorials\/bowlingwesternrealitykit\/01-projectsetup#SwiftUI%EC%99%80-RealityKit-%EC%97%B0%EA%B2%B0","title":"SwiftUI와 RealityKit 연결","role":"pseudoSymbol","kind":"section","identifier":"doc:\/\/com.gentlemanleague.BowlingWesternRealityKit\/tutorials\/BowlingWesternRealityKit\/01-ProjectSetup#SwiftUI%EC%99%80-RealityKit-%EC%97%B0%EA%B2%B0"},"doc://com.gentlemanleague.BowlingWesternRealityKit/tutorials/BowlingWesternRealityKit/-------------":{"url":"\/tutorials\/bowlingwesternrealitykit\/-------------","kind":"article","abstract":[],"type":"topic","identifier":"doc:\/\/com.gentlemanleague.BowlingWesternRealityKit\/tutorials\/BowlingWesternRealityKit\/-------------","role":"article","title":"서부극 배경으로 교체하기"},"05-WesternOverlayAsset.swift":{"type":"file","fileName":"WesternOverlayAsset.swift","fileType":"swift","content":["enum WesternOverlayAsset: String, CaseIterable {","    case saloonSign","    case woodenRails","    case dustTrail","    case sheriffBadge","    case sunsetBackdrop","    case westernTown","}"],"syntax":"swift","identifier":"05-WesternOverlayAsset.swift","highlights":[]},"doc://com.gentlemanleague.BowlingWesternRealityKit/tutorials/BowlingWesternRealityKit/04-VideoExport":{"title":"AR Recording Pipeline","estimatedTime":"30min","kind":"project","abstract":[{"type":"text","text":"촬영 중 보이는 볼러 원본 영상과 서부극으로 교체된 배경을 하나의 공유 가능한 영상으로 녹화 저장하는 파이프라인을 설계합니다."}],"type":"topic","identifier":"doc:\/\/com.gentlemanleague.BowlingWesternRealityKit\/tutorials\/BowlingWesternRealityKit\/04-VideoExport","role":"project","url":"\/tutorials\/bowlingwesternrealitykit\/04-videoexport"},"gentlemanleague-style-reference.png":{"type":"image","variants":[{"url":"\/images\/com.gentlemanleague.BowlingWesternRealityKit\/gentlemanleague-style-reference.png","traits":["1x","light"]}],"identifier":"gentlemanleague-style-reference.png","alt":"젠틀맨리그 서부극 볼링 스타일 레퍼런스"},"doc://com.gentlemanleague.BowlingWesternRealityKit/tutorials/BowlingWesternRealityKit/01-ProjectSetup#%EA%B6%8C%ED%95%9C%EA%B3%BC-%EC%9E%85%EB%A0%A5-%EC%A4%80%EB%B9%84":{"title":"권한과 입력 준비","identifier":"doc:\/\/com.gentlemanleague.BowlingWesternRealityKit\/tutorials\/BowlingWesternRealityKit\/01-ProjectSetup#%EA%B6%8C%ED%95%9C%EA%B3%BC-%EC%9E%85%EB%A0%A5-%EC%A4%80%EB%B9%84","role":"pseudoSymbol","url":"\/tutorials\/bowlingwesternrealitykit\/01-projectsetup#%EA%B6%8C%ED%95%9C%EA%B3%BC-%EC%9E%85%EB%A0%A5-%EC%A4%80%EB%B9%84","abstract":[{"type":"text","text":"SwiftUI 앱에서 ARKit 카메라 세션, Vision 사람 분리, RealityKit 배경 장면을 연결해 촬영 중 배경 변환을 표시할 준비를 합니다."}],"kind":"section","type":"section"},"06-WesternOverlayBuilder.swift":{"type":"file","identifier":"06-WesternOverlayBuilder.swift","content":["import RealityKit","","struct WesternOverlayBuilder {","    func makeScene(for lane: BowlingLaneAnchorDescription) -> Entity {","        let root = Entity()","        root.name = \"Gentleman League Western Overlay\"","","        let sign = ModelEntity(","            mesh: .generateBox(size: [1.4, 0.12, 0.5]),","            materials: [SimpleMaterial(color: .brown, isMetallic: false)]","        )","        sign.name = WesternOverlayAsset.saloonSign.rawValue","        sign.position = [0, 0.45, -2.2]","","        let leftRail = makeRail(x: -0.85)","        let rightRail = makeRail(x: 0.85)","","        root.addChild(sign)","        root.addChild(leftRail)","        root.addChild(rightRail)","        return root","    }","","    private func makeRail(x: Float) -> ModelEntity {","        let rail = ModelEntity(","            mesh: .generateBox(size: [0.08, 0.08, 3.6]),","            materials: [SimpleMaterial(color: .brown, isMetallic: false)]","        )","        rail.position = [x, -0.12, -1.2]","        return rail","    }","}"],"fileType":"swift","highlights":[],"syntax":"swift","fileName":"WesternOverlayBuilder.swift"},"doc://com.gentlemanleague.BowlingWesternRealityKit/tutorials/BowlingWesternRealityKit/--------":{"title":"앱 기반 만들기","identifier":"doc:\/\/com.gentlemanleague.BowlingWesternRealityKit\/tutorials\/BowlingWesternRealityKit\/--------","r